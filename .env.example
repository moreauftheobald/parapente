# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_NAME=ParapenteFR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# ──────────────────────────────────────────
# Base de données
# ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=parapente-mariadb
DB_PORT=3306
DB_DATABASE=parapente
DB_USERNAME=parapente_user
DB_PASSWORD=change_me_in_production

MYSQL_ROOT_PASSWORD=change_root_password_too

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_HOST=parapente-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ──────────────────────────────────────────
# Cache / Queue / Session
# ──────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ──────────────────────────────────────────
# Mail (MailDev en dev)
# ──────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=parapente-mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@parapente.local
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────
# APIs météo
# ──────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_CACHE_TTL=3600

# ──────────────────────────────────────────
# APIs balises
# ──────────────────────────────────────────
PIOUPIOU_BASE_URL=https://api.pioupiou.fr/v1
FFVL_BALISES_URL=https://data.ffvl.fr/api

# ──────────────────────────────────────────
# Xdebug
# ──────────────────────────────────────────
XDEBUG_MODE=develop,debug
